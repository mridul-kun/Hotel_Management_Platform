{
    "name": "antique-pages-hotel",
    "version": "1.0.0",
    "description": "Hotel management app for Antique Pages Hotel & Estate — rooms, guests, staff and expense tracking.",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "server": "node server.js",
        "dist": "electron-builder"
    },
    "dependencies": {
        "express": "^4.19.2"
    },
    "devDependencies": {
        "electron": "^44.4.5",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.player.antiquepageshotel",
        "productName": "AntiquePagesHotel",
        "directories": {
            "output": "C:/AntiqueHotelBuild"
        },
        "files": [
            "main.js",
            "server.js",
            "db.js",
            "public/**/*",
            "package.json"
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico"
        }
    }
}